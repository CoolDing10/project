{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release with tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "BUILD_VIDEO_APPS": "ON"
      }
    },
    {
      "name": "controller-only",
      "displayName": "Controller and protocol only",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-controller",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_VIDEO_APPS": "OFF",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "jobs": 2 },
    { "name": "controller-only", "configurePreset": "controller-only", "jobs": 2 }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "controller-only", "configurePreset": "controller-only", "output": { "outputOnFailure": true } }
  ]
}
